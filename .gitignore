# === Terraform ===
# Provider plugins / modules cache (629 MB — jamás versionar)
**/.terraform/
# Estado e info de lock (ARNs, posibles datos sensibles)
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log
# Variables (pueden contener secretos); el lock.hcl SÍ se versiona
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# (se conserva .terraform.lock.hcl)
!*.tfvars.example

# === Secretos / credenciales ===
.env
*.env
*.pem
*.key
*.pfx
id_rsa*
credentials
.aws/

# === Python (site/_build.py) ===
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# === OS / OneDrive ===
.DS_Store
Thumbs.db
desktop.ini
~$*

# === Editor ===
.vscode/
.idea/

# === Claude Code ===
.claude/worktrees/

# === Dev server (generado automáticamente) ===
_catalog.html

# === Archivos fuente grandes (BanCoppel / clientes) ===
# source/ COMPLETO no se versiona. Es el corpus crudo del cliente (Regla P1):
# RFPs, contratos, propuestas, regulación, inventarios, código y logs. La capa
# que sí se versiona es knowledge-base/, que es el corpus ya curado.
# El corpus crudo cruza la frontera de cliente y la de tercero (Regla B42).
**/source/
# ZIPs de respaldo de carpetas completas — redundantes con los archivos mismos
*.zip
# brain.db NUNCA se commitea (regla del proyecto) — se reconstruye con build-brain.py
**/digital-brain/brain.db
**/digital-brain/brain.db.backup-*
# Brains de nivel cliente: bank-brain.db, liverpool-brain.db, axa-brain.db, etc.
**/*-brain/*-brain.db
**/*-brain/*-brain.db.backup-*
# Journal de SQLite (compañeros de brain.db — transitorios, nunca versionar)
**/digital-brain/*.db-shm
**/digital-brain/*.db-wal
**/*-brain/*.db-shm
**/*-brain/*.db-wal
*.bak
