{
  "Comment": "Red de seguridad: detiene la EC2 del demo 1 h despues de que entra en 'running', aunque el SO se cuelgue y el auto-stop interno no dispare.",
  "StartAt": "EsperaUnaHora",
  "States": {
    "EsperaUnaHora": {
      "Type": "Wait",
      "Seconds": 3600,
      "Next": "DetenerInstancia"
    },
    "DetenerInstancia": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:stopInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.detail['instance-id'])"
      },
      "End": true
    }
  }
}
