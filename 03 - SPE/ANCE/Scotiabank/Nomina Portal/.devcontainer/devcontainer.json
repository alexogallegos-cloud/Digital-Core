{
  "name": "Portal Empresas Nomina · Scotiabank Mexico (mock)",
  "dockerComposeFile": ["../source/docker-compose.yml"],
  "service": "nomina-api",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": true
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "Angular.ng-template",
        "redhat.vscode-yaml",
        "ms-mssql.mssql"
      ]
    }
  },
  "remoteUser": "root"
}