          border: 1px solid #cbd5e1;
          padding: 8px 10px;
          text-align: left;
          font-size: 10pt;
        }
        th {
          background-color: #f1f5f9;
          color: #0f172a;
          font-weight: bold;
        }
        .badge {
          display: inline-block;
          padding: 2px 8px;
          font-size: 9pt;
