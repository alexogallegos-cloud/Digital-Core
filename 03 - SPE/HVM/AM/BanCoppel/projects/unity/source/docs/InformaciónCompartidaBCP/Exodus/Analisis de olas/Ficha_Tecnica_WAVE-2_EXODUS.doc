              <td><strong>Grupo</strong></td><td>Motor / Servicio</td>
            </tr>
            <tr>
              <td><strong>Pertenece a Core</strong></td><td>SÍ (Core Bancario)</td>
              <td><strong>Criticidad</strong></td><td>Alta</td>
            </tr>
            <tr>
              <td><strong>Hosting Actual</strong></td><td>On-Premise</td>
