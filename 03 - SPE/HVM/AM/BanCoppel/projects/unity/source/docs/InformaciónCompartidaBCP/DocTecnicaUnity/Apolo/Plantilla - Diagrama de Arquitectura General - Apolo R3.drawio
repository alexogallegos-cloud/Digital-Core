        </mxCell>
        <mxCell id="INjJEYZjcuKNqnobiy-t-12" parent="INjJEYZjcuKNqnobiy-t-1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;dashed=1;" value="DOMAIN" vertex="1">
