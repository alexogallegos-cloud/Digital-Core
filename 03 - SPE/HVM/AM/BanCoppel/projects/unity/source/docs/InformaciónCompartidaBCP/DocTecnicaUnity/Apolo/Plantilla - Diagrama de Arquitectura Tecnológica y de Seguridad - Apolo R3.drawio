        <mxCell id="P_DqqLAVESB1Nu6i92BC-6" parent="P_DqqLAVESB1Nu6i92BC-1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];rounded=1;absoluteArcSize=1;arcSize=2;html=1;strokeColor=#808080;gradientColor=none;shadow=0;dashed=1;fontSize=15;fontColor=#808080;align=left;verticalAlign=top;spacing=11;spacingTop=0;whiteSpace=wrap;fillColor=default;fontStyle=1;strokeWidth=2;" value="&lt;div&gt;Security&lt;/div&gt;" vertex="1">
