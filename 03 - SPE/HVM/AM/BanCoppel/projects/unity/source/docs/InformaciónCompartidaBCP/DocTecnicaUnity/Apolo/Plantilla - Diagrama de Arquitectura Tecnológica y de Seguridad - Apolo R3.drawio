        <mxCell id="SWsrtFki56pvHDMdTCZM-5" parent="SWsrtFki56pvHDMdTCZM-1" style="fillColor=default;strokeColor=#808080;shadow=0;gradientColor=none;fontSize=15;align=left;spacing=10;fontColor=#808080;9E9E9E;verticalAlign=top;spacingTop=-4;fontStyle=0;spacingLeft=40;html=1;whiteSpace=wrap;container=0;dashed=1;strokeWidth=2;" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;b&gt;GCP BanCoppel&lt;/b&gt;" vertex="1">
