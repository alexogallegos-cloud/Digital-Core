          </mxGeometry>
        </mxCell>
        <mxCell id="ZZdREAJQ6iB1Inpft72Z-4" edge="1" parent="1" source="comp_temenos_tx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=classic;startFill=1;strokeWidth=2;" target="comp_yugabyte_oltp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sXBRRnGxhtzYZETq5MGa-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Notas sesión Temenos&lt;/b&gt;:&lt;div&gt;&lt;ul&gt;&lt;li&gt;Versión actual R24 (hay una nueva cada año)&lt;/li&gt;&lt;li&gt;Pensar en una versión superior puede ser óptimo&lt;/li&gt;&lt;li&gt;Sí utiliza Temenos Integration Framework&lt;/li&gt;&lt;li&gt;Tenemos Temenos Developer&lt;/li&gt;&lt;li&gt;Se pueden hacer desarrollos a medida (se recibe la documentación correspondiente&lt;/li&gt;&lt;li&gt;Consideran que en fase 2 se van a llevar a cabo más desarrollos a la medida&lt;/li&gt;&lt;li&gt;Transact no será consumido por otro Legacy, sino que van a pasar por la capa intermedia&lt;/li&gt;&lt;li&gt;No podemos mover el Temenos API Gateway&lt;/li&gt;&lt;li&gt;Es una solución tipo On-Premise&lt;br&gt;&lt;/li&gt;&lt;li&gt;Podemos modificar autenticación (JWT, headers, etc)&amp;nbsp;&lt;br&gt;&lt;/li&gt;&lt;li&gt;Nosotros nos encargamos de hacer orquestaciones a nivel Core (nos van a proveer la documentación)&lt;/li&gt;&lt;li&gt;Sí hay una separación de lectura y escritura&lt;/li&gt;&lt;li&gt;Data Event Streaming (para eventos)&lt;/li&gt;&lt;li&gt;TDH solo recibe información de Transact&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="320" width="640" x="1370" y="860" as="geometry" />
        </mxCell>
        <mxCell id="sXBRRnGxhtzYZETq5MGa-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Notas sesión ATMS&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;No hay microservicios intermedios&lt;/li&gt;&lt;li&gt;Hay algunas operaciones que consultan servicios en el WAS&lt;/li&gt;&lt;li&gt;Reglas de negocio en SPS&lt;/li&gt;&lt;li&gt;Entra por el IST&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
