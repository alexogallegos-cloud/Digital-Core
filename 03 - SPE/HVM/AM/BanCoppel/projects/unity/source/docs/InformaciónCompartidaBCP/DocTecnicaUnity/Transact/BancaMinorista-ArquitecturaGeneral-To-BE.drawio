        <mxCell id="edge_lambda_s3" edge="1" parent="1" source="7wFuDw5EqrEqI5YogBqv-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#FF6D00;dashed=1;dashPattern=8 4;startArrow=classic;endArrow=none;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endFill=0;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="8NkEswOM0-0RnKy_NaM5-5">
