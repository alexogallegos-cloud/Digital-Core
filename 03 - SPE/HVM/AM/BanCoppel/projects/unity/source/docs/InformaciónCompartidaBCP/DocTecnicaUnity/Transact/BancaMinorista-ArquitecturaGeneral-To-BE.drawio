        </mxCell>
        <mxCell id="col_flow_panel" parent="1" style="swimlane;rounded=1;whiteSpace=wrap;html=1;strokeColor=#CFCFCF;dashed=1;strokeWidth=2;startSize=40;fillColor=#ffffff;fontStyle=1;fontSize=14;" value="Diagrama de Flujo" vertex="1">
          <mxGeometry height="990" width="400" x="2310" y="20" as="geometry" />
        </mxCell>
        <mxCell id="txt_flow_desc" parent="col_flow_panel" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;fontSize=13;spacingTop=10;spacingLeft=15;spacingRight=15;verticalAlign=top;" value="&lt;ol style=&quot;font-size: 13px;&quot;&gt;&lt;br&gt;  &lt;li&gt;&lt;p&gt;Canales Digitales (Frontend): El usuario inicia la operación a través de App Móvil o Web enviando peticiones HTTPS.&lt;/p&gt;&lt;/li&gt;&lt;br&gt;  &lt;li&gt;&lt;p&gt;Akamai WAF / CDN (Seguridad):&lt;/p&gt;&lt;/li&gt;&lt;br&gt;  &lt;li style=&quot;&quot;&gt;&lt;p&gt;MuleSoft API Gateway (Integration): Valida y rutea la petición consultando en tiempo real al CIR en memoria.&lt;/p&gt;&lt;/li&gt;&lt;br&gt;  &lt;li style=&quot;&quot;&gt;&lt;p&gt;Core Identity Registry (Cómputo): Caché distribuido Redis que asocia e inyecta la cabecera X-Core-Owner.&lt;/p&gt;&lt;/li&gt;&lt;br&gt;  &lt;li style=&quot;&quot;&gt;&lt;p&gt;Spring Boot Write Model (Cómputo): Microservicio encargado de coordinar de manera síncrona la afectación financiera sobre el core correspondido.&lt;/p&gt;&lt;/li&gt;&lt;br&gt;  &lt;li style=&quot;&quot;&gt;&lt;p&gt;Temenos Transact / YugabyteOLTP / PISA (Backend): Motores transaccionales core que procesan y consolidan la mutación de saldos.&lt;/p&gt;&lt;/li&gt;&lt;br&gt;  &lt;li style=&quot;&quot;&gt;&lt;p&gt;Apache Kafka (Broker): Tras confirmarse el cambio en el core, Spring Boot publica un evento de negocio asíncrono para desacoplamiento operativo.&lt;/p&gt;&lt;/li&gt;&lt;br&gt;  &lt;li style=&quot;&quot;&gt;&lt;p&gt;TDH Ingestion Engine (Cómputo): Consume los eventos de Kafka de forma aislada y reactiva.&lt;/p&gt;&lt;/li&gt;&lt;br&gt;  &lt;li style=&quot;&quot;&gt;&lt;p&gt;YugabyteDB ODS (Backend): Recibe actualizaciones en menos de 50ms para mantener la consistencia eventual de lecturas operativas.&lt;/p&gt;&lt;/li&gt;&lt;br&gt;  &lt;li style=&quot;&quot;&gt;&lt;p&gt;AWS Lambda &amp;amp; S3 (Servicios): Ejecuciones complementarias basadas en eventos transaccionales para procesar logs y resguardo normativo de auditoría.&lt;/p&gt;&lt;/li&gt;&lt;br&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="940" width="380" x="10" y="50" as="geometry" />
        </mxCell>
