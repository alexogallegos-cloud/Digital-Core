        </mxCell>
        <mxCell id="legend_desc_2" parent="legend_box" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#CFD8DC;align=left;spacingLeft=10;" value="Intercambio de eventos asíncronos / Integración vía Broker Apache Kafka (AWS MSK)" vertex="1">
          <mxGeometry height="25" width="500" x="290" y="90" as="geometry" />
        </mxCell>
        <mxCell id="legend_sym_3" parent="legend_box" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontStyle=1;fontColor=#2E7D32;" value="Malla Istio (EKS) / Contenedor" vertex="1">
          <mxGeometry height="25" width="280" x="10" y="115" as="geometry" />
        </mxCell>
        <mxCell id="legend_desc_3" parent="legend_box" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#CFD8DC;align=left;spacingLeft=10;" value="Aislamiento lógico, enrutamiento interno de microservicios y políticas mTLS" vertex="1">
          <mxGeometry height="25" width="500" x="290" y="115" as="geometry" />
        </mxCell>
        <mxCell id="kKAHo13w1dveKTpF2lBF-13" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1;dashed=1;startSize=40;collapsible=0;" value="ANALÍTICA / DATA WAREHOUSE" vertex="1">
          <mxGeometry height="1000" width="300" x="2624" y="130" as="geometry" />
        </mxCell>
        <mxCell id="6ip6UgZ3ncSODN-cBb_T-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Notas sesión Temenos&lt;/b&gt;:&lt;div&gt;&lt;ul&gt;&lt;li&gt;Versión actual R24 (hay una nueva cada año)&lt;/li&gt;&lt;li&gt;Pensar en una versión superior puede ser óptimo&lt;/li&gt;&lt;li&gt;Sí utiliza Temenos Integration Framework&lt;/li&gt;&lt;li&gt;Tenemos Temenos Developer&lt;/li&gt;&lt;li&gt;Se pueden hacer desarrollos a medida (se recibe la documentación correspondiente&lt;/li&gt;&lt;li&gt;Consideran que en fase 2 se van a llevar a cabo más desarrollos a la medida&lt;/li&gt;&lt;li&gt;Transact no será consumido por otro Legacy, sino que van a pasar por la capa intermedia&lt;/li&gt;&lt;li&gt;No podemos mover el Temenos API Gateway&lt;/li&gt;&lt;li&gt;Es una solución tipo On-Premise&lt;br&gt;&lt;/li&gt;&lt;li&gt;Podemos modificar autenticación (JWT, headers, etc)&amp;nbsp;&lt;br&gt;&lt;/li&gt;&lt;li&gt;Nosotros nos encargamos de hacer orquestaciones a nivel Core (nos van a proveer la documentación)&lt;/li&gt;&lt;li&gt;Sí hay una separación de lectura y escritura&lt;/li&gt;&lt;li&gt;Data Event Streaming (para eventos)&lt;/li&gt;&lt;li&gt;TDH solo recibe información de Transact&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="320" width="640" x="1610" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="6ip6UgZ3ncSODN-cBb_T-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Notas sesión ATMS&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;No hay microservicios intermedios&lt;/li&gt;&lt;li&gt;Hay algunas operaciones que consultan servicios en el WAS&lt;/li&gt;&lt;li&gt;Reglas de negocio en SPS&lt;/li&gt;&lt;li&gt;Entra por el IST&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="790" x="1010" y="1280" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="azYCA2D45yOiZ1ZnobLt" name="Borrador 1">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="3500" pageHeight="2500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo_arquitectura" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4DA1F5;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" value="ARQUITECTURA GENERAL BANCOPPEL - PLATAFORMA HÍBRIDA TRANSACT (CQRS)" vertex="1">
          <mxGeometry height="70" width="2920" as="geometry" />
        </mxCell>
        <mxCell id="canvas_root" parent="1" style="fillColor=#E3F2FD;opacity=100;strokeColor=#BBDEFB;strokeWidth=1;rounded=0;glass=0;shadow=0;gradientColor=none;pointerEvents=0;container=0;" value="" vertex="1">
          <mxGeometry height="660" width="2920" y="70" as="geometry" />
        </mxCell>
        <mxCell id="panel_flujo" parent="1" style="swimlane;whiteSpace=wrap;html=1;strokeColor=#CFCFCF;dashed=1;strokeWidth=2;startSize=40;fillColor=#FFFFFF;fontStyle=1;fontSize=14;rounded=1;verticalAlign=top;" value="DIAGRAMA DE FLUJO" vertex="1">
          <mxGeometry height="1950" width="400" x="2930" as="geometry" />
        </mxCell>
        <mxCell id="texto_flujo_lista" parent="panel_flujo" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;fontSize=13;spacingTop=5;spacingLeft=10;spacingRight=10;verticalAlign=top;" value="&lt;ol&gt;&lt;h3 data-pm-slice=&quot;1 4 []&quot;&gt;1. Canales de Entrada (Punto de Contacto)&lt;/h3&gt;&lt;blockquote&gt;&lt;p&gt;&lt;strong&gt;Canales de Entrada:&lt;/strong&gt; Interacciones financieras y operativas gatilladas desde canales digitales (&lt;strong&gt;Banca Móvil / Portal Web&lt;/strong&gt;), físicos (&lt;strong&gt;Red de Cajeros Automáticos - ATMs&lt;/strong&gt;) y de atención presencial/operación interna (&lt;strong&gt;Ventanilla en Sucursal / CAT&lt;/strong&gt;).&lt;/p&gt;&lt;/blockquote&gt;&lt;h3&gt;2. Seguridad Perimetral (Frontera Zero Trust)&lt;/h3&gt;&lt;blockquote&gt;&lt;p&gt;&lt;strong&gt;Seguridad Perimetral (Zero Trust):&lt;/strong&gt; Inspección estricta en Capa 7 y mitigación de amenazas a través de &lt;strong&gt;Akamai WAF/CDN&lt;/strong&gt; para tráfico de canales digitales, combinado con aislamiento de seguridad mediante canales dedicados &lt;strong&gt;IPsec VPN&lt;/strong&gt; para la red transaccional de ATMs.&lt;/p&gt;&lt;/blockquote&gt;&lt;h3&gt;3. Capa de Integración y API Gateway (MuleSoft ESB)&lt;/h3&gt;&lt;blockquote&gt;&lt;p&gt;&lt;strong&gt;MuleSoft API Gateway &amp;amp; ESB:&lt;/strong&gt; Único punto de gobierno, desacoplamiento y orquestación que implementa la &lt;strong&gt;Taxonomía Semántica Unificada&lt;/strong&gt;. Inspecciona y rutea el tráfico de manera física estricta en: comandos de escritura (&lt;code&gt;/v1/commands/&lt;/code&gt;) hacia el Core y consultas de lectura (&lt;code&gt;/v1/queries/&lt;/code&gt;) hacia el TDH, eliminando riesgos de regresión en los frontends.&lt;/p&gt;&lt;/blockquote&gt;&lt;h3&gt;4. Capa de Cómputo y Procesamiento (EKS / Istio)&lt;/h3&gt;&lt;blockquote&gt;&lt;p&gt;&lt;strong&gt;Capa de Cómputo (AWS EKS &amp;amp; Istio):&lt;/strong&gt; Microservicios elásticos en Spring Boot gobernados por una malla de servicios (&lt;em&gt;Service Mesh&lt;/em&gt;) Istio. Ejecutan la lógica intermedia del negocio, interactuando con el Core mediante &lt;em&gt;Temenos API Gateway&lt;/em&gt;. En esta capa residen los pods efímeros de &lt;strong&gt;Spring Batch&lt;/strong&gt; para la normalización en paralelo durante el &lt;em&gt;Data Seeding&lt;/em&gt;.&lt;/p&gt;&lt;/blockquote&gt;&lt;h3&gt;5. Principio CQRS de Lecturas (Capa de Datos Read-Only)&lt;/h3&gt;&lt;blockquote&gt;&lt;p&gt;&lt;strong&gt;CQRS - Capa de Lectura (TDH):&lt;/strong&gt; Redirección inmediata de flujos de consulta (&lt;code&gt;/v1/queries/&lt;/code&gt;) hacia el clúster de &lt;strong&gt;Temenos Data Hub (YugabyteDB ODS)&lt;/strong&gt;. Las lecturas pesadas se resuelven en esta réplica activa de alta velocidad, aislando por completo al Core Transact de la concurrencia operativa de los canales.&lt;/p&gt;&lt;/blockquote&gt;&lt;h3&gt;6. Capa Transaccional de Escrituras (Core Transact)&lt;/h3&gt;&lt;blockquote&gt;&lt;p&gt;&lt;strong&gt;CQRS - Capa de Escritura (Temenos Transact):&lt;/strong&gt; Procesamiento, validación en caliente y registro sincronizado de comandos financieros (&lt;code&gt;/v1/commands/&lt;/code&gt;) sobre el motor OLTP de &lt;strong&gt;Temenos Transact&lt;/strong&gt;. Almacena la &lt;em&gt;&quot;Verdad Operativa&quot;&lt;/em&gt; en tiempo real sobre el clúster principal de &lt;strong&gt;YugabyteDB (Core OLTP)&lt;/strong&gt; bajo latencias objetivo de nivel militar (&amp;lt;50ms).&lt;/p&gt;&lt;/blockquote&gt;&lt;h3&gt;7. Bus de Eventos Empresariales (Apache Kafka)&lt;/h3&gt;&lt;blockquote&gt;&lt;p&gt;&lt;strong&gt;Bus de Eventos (Apache Kafka):&lt;/strong&gt; Columna vertebral orientada a eventos (&lt;em&gt;EDA&lt;/em&gt;) que captura de forma asíncrona y ordenada los hechos de negocio del Core Bancario. Durante la migración, aloja adicionalmente el canal de ingesta masiva (&lt;code&gt;coppel.tdh.historical-seeding.v1&lt;/code&gt;) para actuar como amortiguador (&lt;em&gt;backpressure&lt;/em&gt;) en el poblamiento del histórico profundo hacia el TDH.&lt;/p&gt;&lt;/blockquote&gt;&lt;h3&gt;8. Persistencia, Libro Mayor y Analítica (Capa Data / Legacy)&lt;/h3&gt;&lt;blockquote&gt;&lt;p&gt;&lt;strong&gt;Capa de Persistencia Final, Regulación y Analítica:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;Staging (Amazon S3):&lt;/strong&gt; Almacenamiento plano cifrado con AWS KMS para el poblamiento veloz (&lt;em&gt;YSQL COPY Bulk Ingest&lt;/em&gt;) hacia el core vivo.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;Libro Mayor Oficial (Informix PISA):&lt;/strong&gt; Base de datos legada alimentada de manera asíncrona estructurada, actuando como el diario contable oficial ante reguladores (&lt;em&gt;CNBV Gold Standard Financial Layer&lt;/em&gt;).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;Capa Analítica (Data Warehouse / Lake):&lt;/strong&gt; Destino final de eventos agregados para inteligencia de negocio y reportería regulatoria masiva.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/blockquote&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="1900" width="380" x="10" y="50" as="geometry" />
        </mxCell>
