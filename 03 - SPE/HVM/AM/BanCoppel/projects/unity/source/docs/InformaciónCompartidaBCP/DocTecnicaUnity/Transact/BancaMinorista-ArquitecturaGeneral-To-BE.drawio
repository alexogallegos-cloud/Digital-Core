        <mxCell id="legend_sym_2" parent="legend_box" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#FF6D00;strokeWidth=2;dashed=1;dashPattern=8 4;fontStyle=1;fontColor=#FF6D00;" value="Línea Punteada Naranja" vertex="1">
