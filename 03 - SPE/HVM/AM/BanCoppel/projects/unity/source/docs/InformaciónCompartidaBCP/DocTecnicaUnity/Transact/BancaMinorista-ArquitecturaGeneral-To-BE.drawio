    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4DA1F5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" value="DIAGRAMA DE ARQUITECTURA GENERAL - NUEVO CANAL NATIVO" vertex="1">
          <mxGeometry height="40" width="1540" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="canvas_root" parent="1" style="fillColor=#E3F2FD;opacity=100;strokeColor=#BBDEFB;strokeWidth=1;rounded=0;glass=0;shadow=0;gradientColor=none;pointerEvents=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;container=0;" value="" vertex="1">
          <mxGeometry height="690" width="1540" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="panel_flujo" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fillColor=#ffffff;strokeColor=#CFCFCF;dashed=1;strokeWidth=2;fontStyle=1;fontSize=13;verticalAlign=top;" value="DIAGRAMA DE FLUJO / SECUENCIA LÓGICA" vertex="1">
          <mxGeometry height="560" width="400" x="1580" y="20" as="geometry" />
        </mxCell>
        <mxCell id="texto_flujo" parent="panel_flujo" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;fontSize=12;spacingTop=10;spacingLeft=10;spacingRight=10;verticalAlign=top;" value="&lt;ol style=&quot;font-size: 12px; margin-left: 10px; padding-left: 10px;&quot;&gt;&#xa;  &lt;li&gt;&lt;b&gt;Nuevo Canal Nativo:&lt;/b&gt; Envía la solicitud transaccional/consulta desde la banca corporativa o sistema tercero.&lt;/li&gt;&#xa;  &lt;li&gt;&lt;b&gt;Akamai WAF:&lt;/b&gt; Bloquea amenazas perimetrales y valida que la petición provenga de un origen seguro.&lt;/li&gt;&#xa;  &lt;li&gt;&lt;b&gt;MuleSoft BFF:&lt;/b&gt; Realiza la validación estructural estricta bajo RAML y convierte el payload al estándar BIAN.&lt;/li&gt;&#xa;  &lt;li&gt;&lt;b&gt;MuleSoft Domain:&lt;/b&gt; Ejecuta la lógica semántica de CQRS, dividiendo el flujo en Comandos (escritura) o Consultas (lectura).&lt;/li&gt;&#xa;  &lt;li&gt;&lt;b&gt;Spring Boot - Write Model:&lt;/b&gt; Recibe los comandos y ejecuta las orquestaciones de escritura sobre las APIs de Temenos Transact.&lt;/li&gt;&#xa;  &lt;li&gt;&lt;b&gt;Temenos Transact:&lt;/b&gt; Valida y procesa las reglas contables/financieras del core del banco.&lt;/li&gt;&#xa;  &lt;li&gt;&lt;b&gt;YugabyteDB OLTP:&lt;/b&gt; Almacena los registros transaccionales garantizando consistencia ACID.&lt;/li&gt;&#xa;  &lt;li&gt;&lt;b&gt;Spring Boot - Read Model:&lt;/b&gt; Procesa las solicitudes de consulta de manera directa, evitando tocar el core transaccional.&lt;/li&gt;&#xa;  &lt;li&gt;&lt;b&gt;YugabyteDB ODS (TDH):&lt;/b&gt; Atiende las lecturas de forma óptima a través de los almacenes de datos operacionales sincronizados.&lt;/li&gt;&#xa;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="490" width="380" x="10" y="50" as="geometry" />
        </mxCell>
