             /* ========================================================= */
             /* PROGRAMA : PROCNOC  (CL - Control Language)               */
             /* PROPOSITO: Proceso nocturno de emision de polizas         */
             /* LLAMA A   : POLVAL -> POLALT -> RPTSIN -> BCKPOL          */
             /*             BCKPOL no tiene fuente [SHADOW INVENTORY]      */
             /* ========================================================= */
             PGM

             /* Validacion y autorizacion de polizas pendientes */
             CALL       PGM(POLVAL)

             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             /* Alta de polizas autorizadas */
             CALL       PGM(POLALT)

             /* Reporte de siniestros del anio */
             CALL       PGM(RPTSIN)

             /* Respaldo del maestro de polizas - BCKPOL sin fuente */
             /* [SHADOW INVENTORY PLANTADO] */
             CALL       PGM(BCKPOL)

             RETURN

 ERROR:      SNDPGMMSG  MSG('Error en proceso nocturno de polizas')
             ENDPGM