% =================================================================
% DASDL : COREBANK  -  Schema DMSII del core bancario (ClearPath MCP)
% SISTEMA: SISTEMA-CORE-UNISYS
% =================================================================
OPTIONS (AUDIT, REORGANIZATION);

CLIENTE DATA SET
  (
  CLI-ID         NUMBER (10);
  CLI-NOMBRE     ALPHA (40);
  CLI-RFC        ALPHA (13);
  CLI-SEGMENTO   ALPHA (2);
  CLI-STATUS     ALPHA (2);
  );

CUENTA DATA SET
  (
  CTA-NUM        NUMBER (12);
  CTA-CLIENTE    NUMBER (10);
  CTA-PRODUCTO   ALPHA (4);
  CTA-SALDO      NUMBER (15, 2);
  CTA-MONEDA     ALPHA (3);
  CTA-STATUS     ALPHA (2);
  CTA-FECHA-APE  NUMBER (8);
  );

MOVIMIENTO DATA SET
  (
  MOV-ID         NUMBER (15);
  MOV-CUENTA     NUMBER (12);
  MOV-TIPO       ALPHA (2);
  MOV-IMPORTE    NUMBER (15, 2);
  MOV-FECHA      NUMBER (8);
  MOV-GL-ASIENTO NUMBER (15);
  );

ASIENTO-GL DATA SET
  (
  GL-ASIENTO     NUMBER (15);
  GL-CUENTA-CONT ALPHA (10);
  GL-CARGO       NUMBER (15, 2);
  GL-ABONO       NUMBER (15, 2);
  GL-FECHA       NUMBER (8);
  );

% --- SETS (indices) ---
CLIENTE-POR-ID SET OF CLIENTE KEY (CLI-ID);
CUENTA-POR-NUM SET OF CUENTA KEY (CTA-NUM);
CUENTA-POR-CLI SET OF CUENTA KEY (CTA-CLIENTE);
MOV-POR-CTA    SET OF MOVIMIENTO KEY (MOV-CUENTA, MOV-FECHA);
GL-POR-ASIENTO SET OF ASIENTO-GL KEY (GL-ASIENTO);

% --- SUBSET con regla de negocio implicita ---
% "cuentas activas con saldo" = la definicion de cartera vigente vive aqui
CUENTAS-VIGENTES SUBSET OF CUENTA
  WHERE (CTA-STATUS = "VI") AND (CTA-SALDO GTR 0);